{
  "name": "graphql-jwt-rbac",
  "version": "1.0.0",
  "description": "Học GraphQL: Apollo Server + JWT + phân quyền admin/user (spec-driven)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "bcryptjs": "^3.0.3",
    "graphql": "^16.14.2"
  }
}
